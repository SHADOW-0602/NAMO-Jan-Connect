# React build-time configuration
VITE_API_URL=https://namo-jan-connect-api.kushagra-singh0602.workers.dev

# Cloudflare Worker non-secret variables (mirrored in backend/wrangler.toml)
FRONTEND_URL=http://localhost:5173,https://namo-jan-connect.pages.dev,https://namo-jan-connect.vercel.app
SESSION_TTL_HOURS=720
MAX_UPLOAD_MB=5

# Configure these as encrypted Worker secrets; never commit real values:
# cd backend
# uv run pywrangler secret put ADMIN_EMAIL
# uv run pywrangler secret put ADMIN_PASSWORD
# uv run pywrangler secret put SMTP_USER
# uv run pywrangler secret put SMTP_PASS
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-gmail-app-password

# Department emails and unique passwords are configured by the administrator
# inside /admin. Only salted password hashes are stored in D1.

# D1 and R2 use native bindings in backend/wrangler.toml.
# No database URL, R2 access key, or R2 secret key is required by the application.
